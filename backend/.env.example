# Google Calendar API key for GCAL room availability scraping
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI= #http://localhost:3003/api/auth/callback/google for dev, https://moffittstatus.asuc.org/api/auth/callback/google for prd
FRONTEND_URL= #http://localhost:3003 for dev, https://moffittstatus.asuc.org for prd (same host as the redirect URI, or the sign-in cookie is lost)
SESSION_SECRET= # generate by running openssl rand -base64 32